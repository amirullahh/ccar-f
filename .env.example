# ---------------------------------------------------------------------------
# Semua variabel di sini OPSIONAL. App tetep jalan tanpa file .env sama sekali.
# Kalau mau dipakai: copy jadi `.env.local` buat lokal, atau set di
# Vercel → Project → Settings → Environment Variables buat produksi.
# ---------------------------------------------------------------------------

# URL publik situs. Dipakai buat `metadataBase` (OpenGraph/canonical) dan
# sitemap.xml. Kalau kosong, default-nya https://claude-exam-guide.vercel.app
# Setelah deploy pertama, ganti ke domain Vercel lu, mis.
# https://claude-exam-guide-id.vercel.app
NEXT_PUBLIC_SITE_URL=https://claude-exam-guide.vercel.app

# Opsional — analytics. Biarin kosong kalau nggak dipakai, tag-nya nggak dirender.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
